<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ app.name }} · Möbius OS</title>
  <meta name="description" content="{{ app.description }}">
  <link rel="icon" type="image/png" href="{{ app.icon_url if app.icon_url else '../mobius-brand.png' }}">
  <link rel="preconnect" href="https://rsms.me/">
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <header class="site">
    <div class="inner">
      <a class="brand" href="../">
        <img src="../mobius-brand.png" alt="" class="brand-mark" width="28" height="28">
        <span>Möbius OS</span>
      </a>
      <nav>
        <a href="./" class="is-active">Apps</a>
        <a href="../spec/">Spec</a>
        <a href="../docs/contributing.html">Build</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <p class="muted"><a href="./">← All apps</a></p>

    <div class="app-hero">
      <div class="app-hero-icon">
        {%- if app.icon_url %}
        <img src="{{ app.icon_url }}" alt="">
        {%- else %}
        <span>{{ app.name[0] }}</span>
        {%- endif %}
      </div>
      <div class="app-hero-text">
        <h1>{{ app.name }}</h1>
        <p class="muted">{{ app.description }}</p>
      </div>
    </div>

    {%- if app.badges %}
    <div class="badges badges--lg">
      {%- for b in app.badges %}
      <span class="badge">{{ b }}</span>
      {%- endfor %}
    </div>
    {%- endif %}

    <div class="meta">
      <span>v{{ app.version }}</span>
      <span>by <a href="https://github.com/{{ app.author }}">{{ app.author }}</a></span>
      <span>{{ app.license }}</span>
      <span><a href="{{ app.homepage }}">Source ↗</a></span>
      {%- if app.github.stars is not none %}
      <span>★ {{ app.github.stars }}</span>
      {%- endif %}
      {%- if app.github.last_commit %}
      <span>updated {{ app.github.last_commit }}</span>
      {%- endif %}
      {%- if app.github.discussions_count is not none and app.github.discussions_count > 0 %}
      <span><a href="{{ app.homepage }}/discussions">{{ app.github.discussions_count }} discussion{{ '' if app.github.discussions_count == 1 else 's' }}</a></span>
      {%- endif %}
      {%- if app.github.open_issues is not none and app.github.open_issues > 0 %}
      <span><a href="{{ app.homepage }}/issues">{{ app.github.open_issues }} open issue{{ '' if app.github.open_issues == 1 else 's' }}</a></span>
      {%- endif %}
    </div>

    <h2>Install</h2>
    <p>
      Open the App Store mini-app in your Möbius shell and paste:
    </p>
    <pre><code>https://raw.githubusercontent.com/mobius-os/{{ app.repo }}/main/mobius.json</code></pre>
    <p>
      Möbius shows the requested permissions{% if app.schedule %} and the cron schedule{% endif %}, then installs.
    </p>

    {%- if app.runtime and app.runtime.esm_deps %}
    <h2>Runtime libraries</h2>
    <p>This app loads the following ES modules from <a href="https://esm.sh">esm.sh</a> on first open:</p>
    <ul>
      {%- for dep in app.runtime.esm_deps %}
      <li><code>{{ dep }}</code></li>
      {%- endfor %}
    </ul>
    {%- endif %}

    <h2>Manifest</h2>
    <details>
      <summary>Show <code>mobius.json</code></summary>
      <pre><code>{{ app.manifest_json }}</code></pre>
    </details>

    <h2>Feedback</h2>
    <p>
      Something feel off, or want to suggest an iteration? Open an issue at
      <a href="{{ app.homepage }}/issues">{{ app.repo }}/issues</a> — the
      curator reads them.
    </p>
  </main>

  <footer class="site">
    <div class="inner">
      <span>Möbius OS · MIT</span>
      <span><a href="https://github.com/mobius-os">github.com/mobius-os</a></span>
    </div>
  </footer>
</body>
</html>
