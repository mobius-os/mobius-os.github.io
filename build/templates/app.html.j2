<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ app.name }} · Möbius OS</title>
  <meta name="description" content="{{ app.description }}">
  <link rel="preconnect" href="https://rsms.me/">
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <header class="site">
    <div class="inner">
      <a class="brand" href="../">Möbius OS</a>
      <nav>
        <a href="./">Apps</a>
        <a href="../spec/">Spec</a>
        <a href="../docs/contributing.html">Contribute</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <p class="muted"><a href="./">← All apps</a></p>

    <div style="display:flex; align-items:center; gap:16px;">
      <div class="logo" aria-hidden="true" style="margin:0;">{{ app.name[0] }}</div>
      <h1 style="margin:0;">{{ app.name }}</h1>
    </div>

    <div class="meta">
      <span>v{{ app.version }}</span>
      <span>by <a href="https://github.com/{{ app.author }}">{{ app.author }}</a></span>
      <span>{{ app.license }}</span>
      <span><a href="{{ app.homepage }}">Source</a></span>
      {%- if app.github.stars is not none %}
      <span>★ {{ app.github.stars }}</span>
      {%- endif %}
      {%- if app.github.last_commit %}
      <span>updated {{ app.github.last_commit }}</span>
      {%- endif %}
      {%- if app.github.discussions_count is not none %}
      <span>{{ app.github.discussions_count }} discussion{{ '' if app.github.discussions_count == 1 else 's' }}</span>
      {%- endif %}
    </div>

    <h2>What it does</h2>
    <p>{{ app.description }}</p>

    <h2>Install</h2>
    <p>
      Open the App Store mini-app in your Möbius shell and paste:
    </p>
    <pre><code>https://raw.githubusercontent.com/mobius-os/{{ app.repo }}/main/mobius.json</code></pre>
    <p>
      Möbius shows the requested permissions{% if app.schedule %} and the cron schedule{% endif %}, then installs.
    </p>

    <h2>Manifest</h2>
    <p>The live <code>mobius.json</code>:</p>
    <pre><code>{{ app.manifest_json }}</code></pre>

    <h2>Screenshots</h2>
    <p class="muted">Coming soon.</p>

    <h2>Ratings</h2>
    <p class="muted">
      Ratings aren't wired up yet. For now: open an issue on
      <a href="{{ app.homepage }}/issues">the repo</a> if something feels off.
    </p>
  </main>

  <footer class="site">
    <div class="inner">
      <span>Möbius OS · MIT</span>
      <span><a href="https://github.com/mobius-os">github.com/mobius-os</a></span>
    </div>
  </footer>
</body>
</html>
