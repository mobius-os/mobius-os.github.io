(mobius_launch_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		-Server
	}
}

mobius.page, mobius.you {
	import mobius_launch_headers
	encode gzip
	request_body {
		max_size 1MB
	}
	rate_limit {
		zone mobius_launch_zone {
			key {remote_host}
			events 300
			window 1m
		}
	}
	reverse_proxy mobius-launch:8080
	log {
		output stdout
		format console
	}
}

www.mobius.page {
	redir https://mobius.page{uri} permanent
}

www.mobius.you {
	redir https://mobius.you{uri} permanent
}
