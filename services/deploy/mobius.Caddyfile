(mobius_launch_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# OAuth starts can redirect top-level navigations through provider hosts.
		# Keep form submissions tight, but allow the public launcher hosts and
		# known provider targets so auth buttons do not appear inert.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self' https://mobius.page https://www.mobius.page https://mobius.you https://www.mobius.you https://accounts.google.com https://backboard.railway.com https://railway.com; frame-ancestors 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		-Server
	}
}

www.mobius.page, www.mobius.you {
	import mobius_launch_headers
	encode gzip
	request_body {
		max_size 1MB
	}
	rate_limit {
		zone mobius_launch_zone {
			key {remote_host}
			events 300
			window 1m
		}
	}
	reverse_proxy mobius-launch:8080
	log {
		output stdout
		format console
	}
}

mobius.page {
	redir https://www.mobius.page{uri} permanent
}

mobius.you {
	redir https://www.mobius.you{uri} permanent
}
