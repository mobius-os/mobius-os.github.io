# Copy this to .env and fill in production values.
# Never commit .env.

# Let's Encrypt certificate registration.
ACME_EMAIL=ops@mobius.you

# Public launcher hosts.
PUBLIC_BASE_URL=https://mobius.you
PUBLIC_CANONICAL_URL=https://mobius.you
PUBLIC_HOSTS=mobius.page,mobius.you

# Deployment provenance reported by /version.
MOBIUS_LAUNCH_GIT_SHA=unknown
# Leave blank to use the Compose-mode default local image name.
MOBIUS_LAUNCH_IMAGE_REF=
MOBIUS_LAUNCH_VOLUME=deploy_mobius_launch_data

# Railway OAuth app credentials.
# Register both callback URLs in Railway:
# https://mobius.you/railway/callback
# https://mobius.page/railway/callback
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=
RAILWAY_OAUTH_SCOPES=openid email profile offline_access workspace:member
RAILWAY_TEMPLATE_URL=https://railway.com/deploy/xVMuX9?referralCode=cERpKq&utm_medium=integration&utm_source=template&utm_campaign=generic
RAILWAY_TEMPLATE_CODE=xVMuX9
RAILWAY_REFERRAL_CODE=cERpKq
# Where onboarding step 1 ("Create your Railway account") sends users. The
# referral must attach at signup -- Railway ignores referralCode on the OAuth
# authorize endpoint. Leave blank to use https://railway.com?referralCode=<code>.
RAILWAY_SIGNUP_URL=

# Google OAuth for launcher sign-in.
# Register both callback URLs in Google Cloud:
# https://mobius.you/auth/google/callback
# https://mobius.page/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep false for public deployments. Set true only for isolated local testing.
ALLOW_PROTOTYPE_EMAIL_LOGIN=false

# Möbius instance storage shown in the launcher UI.
MOBIUS_DEFAULT_VOLUME_SIZE_GB=2
MOBIUS_VOLUME_SIZE_OPTIONS_GB=2,5,10,20
PROVISIONING_STALE_SECONDS=900
